 fn discover_skills_with_config(working_dir: Option<&Path>, config: &Config) -> Vec<SourceEntry> {
+    // Kaus scope v1: only the immutable per-session selection participates in
+    // discovery. Other plugin tools/configuration keep their native lifecycle.
+    if let Some(manifest) = std::env::var_os("KAUS_GOOSE_SKILL_MANIFEST") {
+        let document: serde_json::Value = serde_json::from_str(
+            &std::fs::read_to_string(manifest).expect("Kaus skill manifest unavailable"),
+        ).expect("Kaus skill manifest invalid");
+        assert_eq!(document["schema"].as_u64(), Some(1), "Kaus skill schema unsupported");
+        let files = document["paths"].as_array().expect("Kaus skill paths invalid");
+        let mut result = Vec::new();
+        let mut seen = HashSet::new();
+        for file in files {
+            let path = PathBuf::from(file.as_str().expect("Kaus skill path invalid"));
+            assert!(path.is_absolute() && path.file_name().and_then(|s| s.to_str()) == Some("SKILL.md"), "Kaus skill path invalid");
+            assert!(!std::fs::symlink_metadata(&path).expect("Kaus skill missing").file_type().is_symlink(), "Kaus skill link rejected");
+            let expected = path.canonicalize().expect("Kaus skill unavailable");
+            let dir = path.parent().expect("Kaus skill directory missing");
+            let found: Vec<_> = scan_skills_from_dir(dir, false, false, false, &mut seen)
+                .into_iter().filter(|source| Path::new(&source.path).join("SKILL.md").canonicalize().ok().as_ref() == Some(&expected)).collect();
+            assert_eq!(found.len(), 1, "Kaus selected skill not uniquely loadable");
+            let builtin_docs = document["builtinDocsPaths"].as_array()
+                .is_some_and(|paths| paths.iter().any(|item| item.as_str() == path.to_str()));
+            for mut source in found {
+                if builtin_docs {
+                    let docs_root = config.get_goose_docs_root().expect("Kaus builtin docs configuration invalid")
+                        .unwrap_or_else(|| DEFAULT_GOOSE_DOCS_ROOT.to_string());
+                    source.content = source.content.replace(GOOSE_DOCS_ROOT_PLACEHOLDER, &docs_root);
+                }
+                result.push(source);
+            }
+        }
+        return result;
+    }
     let mut sources: Vec<SourceEntry> = Vec::new();
     let mut seen = HashSet::new();
 
