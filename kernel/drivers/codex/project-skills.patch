+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn kaus_scope_is_exact_and_rejects_dynamic_sources() {
+        let root = tempfile::tempdir().unwrap();
+        let root = root.path().canonicalize().unwrap();
+        let selected = root.join("selected/SKILL.md");
+        std::fs::create_dir_all(selected.parent().unwrap()).unwrap();
+        std::fs::write(&selected, "selected").unwrap();
+        let scope = ManagedScope::parse(&serde_json::to_string(&vec![&selected]).unwrap()).unwrap();
+        assert!(scope.allows(&selected));
+        let dynamic = root.join("selected/new/SKILL.md");
+        std::fs::create_dir_all(dynamic.parent().unwrap()).unwrap();
+        std::fs::write(&dynamic, "dynamic").unwrap();
+        assert!(!scope.allows(&dynamic));
+        assert!(!ManagedScope::parse("[]").unwrap().allows(&selected));
+        assert!(ManagedScope::parse("{}").is_err());
+        assert!(ManagedScope::parse("[\"relative/SKILL.md\"]").is_err());
+        assert!(ManagedScope::parse("[\"/absent/SKILL.md\"]").is_err());
+    }
+
+    #[tokio::test]
+    async fn kaus_scope_removes_implicit_and_foreign_provider_entries() {
+        use crate::catalog::{SkillAuthority, SkillPackageId, SkillResourceId};
+        use codex_skills::ImplicitSkillLookup;
+        let root = tempfile::tempdir().unwrap();
+        let root = root.path().canonicalize().unwrap();
+        for name in ["selected", "unselected"] {
+            let path = root.join(name).join("SKILL.md");
+            std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+            std::fs::write(
+                path,
+                format!("---\nname: {name}\ndescription: test\n---\nbody"),
+            )
+            .unwrap();
+        }
+        let selected = root.join("selected/SKILL.md");
+        let unselected = root.join("unselected/SKILL.md");
+        let scope = ManagedScope::parse(&serde_json::to_string(&vec![&selected]).unwrap()).unwrap();
+        let outcome = crate::loader::load_and_merge_host_skill_roots(
+            vec![crate::loader::HostSkillRoot::host(
+                root.try_into().unwrap(),
+                codex_protocol::protocol::SkillScope::User,
+                std::sync::Arc::clone(&codex_exec_server::LOCAL_FS),
+            )],
+            &tokio::sync::Semaphore::new(1),
+            None,
+            None,
+        )
+        .await
+        .with_disabled_paths(HashSet::new());
+        assert_eq!(outcome.skills.len(), 2);
+        let filtered = scope.filter(outcome);
+        assert_eq!(
+            filtered
+                .skills
+                .iter()
+                .map(|skill| skill.name.as_str())
+                .collect::<Vec<_>>(),
+            vec!["selected"]
+        );
+        assert!(
+            filtered
+                .implicit_skill_for_doc_path(&selected.clone().try_into().unwrap())
+                .is_some()
+        );
+        assert!(
+            filtered
+                .implicit_skill_for_doc_path(&unselected.clone().try_into().unwrap())
+                .is_none()
+        );
+        for kind in [
+            SkillSourceKind::Host,
+            SkillSourceKind::Executor,
+            SkillSourceKind::Cloud,
+            SkillSourceKind::Custom("fixture".to_owned()),
+        ] {
+            let entry = SkillCatalogEntry::new(
+                SkillPackageId("fixture".to_owned()),
+                SkillAuthority::new(kind.clone(), "fixture"),
+                "fixture",
+                "fixture",
+                SkillResourceId::new(selected.to_string_lossy()),
+            );
+            assert_eq!(scope.allows_entry(&entry), kind == SkillSourceKind::Host);
+        }
+        let snapshot = std::sync::Arc::new(crate::HostSkillsSnapshot::new(std::sync::Arc::new(
+            filtered,
+        )));
+        let providers = crate::SkillProviders::new()
+            .with_host_provider(std::sync::Arc::new(crate::HostSkillProvider::new()));
+        for (resource, expected) in [(&selected, true), (&unselected, false)] {
+            let result = providers
+                .read(crate::provider::SkillReadRequest {
+                    _lifetime: std::marker::PhantomData,
+                    authority: SkillAuthority::new(SkillSourceKind::Host, "host"),
+                    package: SkillPackageId(selected.to_string_lossy().into_owned()),
+                    resource: SkillResourceId::new(resource.to_string_lossy()),
+                    resolved_executor_roots: Vec::new(),
+                    sandbox: None,
+                    host_snapshot: Some(std::sync::Arc::clone(&snapshot)),
+                    mcp_resources: None,
+                })
+                .await;
+            assert_eq!(result.is_ok(), expected);
+            if !expected {
+                assert!(result.unwrap_err().message.contains("not loaded"));
+            }
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn kaus_scope_rejects_retargeted_selected_file() {
+        let root = tempfile::tempdir().unwrap();
+        let root = root.path().canonicalize().unwrap();
+        let selected = root.join("SKILL.md");
+        let other = root.join("other.md");
+        std::fs::write(&selected, "selected").unwrap();
+        std::fs::write(&other, "other").unwrap();
+        let scope = ManagedScope::parse(&serde_json::to_string(&vec![&selected]).unwrap()).unwrap();
+        std::fs::remove_file(&selected).unwrap();
+        std::os::unix::fs::symlink(&other, &selected).unwrap();
+        assert!(!scope.allows(&selected));
+    }
+}
