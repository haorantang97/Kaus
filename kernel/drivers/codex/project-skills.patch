diff --git a/codex-rs/ext/skills/src/managed_scope.rs b/codex-rs/ext/skills/src/managed_scope.rs
new file mode 100644
index 0000000..6ef75d4
--- /dev/null
+++ b/codex-rs/ext/skills/src/managed_scope.rs
@@ -0,0 +1,262 @@
+//! Process-fixed project skill scope for the Kaus-owned app-server build.
+//! Native processes without the opt-in variable retain upstream discovery.
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+use crate::SkillLoadOutcome;
+use crate::catalog::{SkillCatalogEntry, SkillSourceKind};
+
+static SCOPE: OnceLock<Result<Option<ManagedScope>, String>> = OnceLock::new();
+
+#[derive(Debug)]
+struct ManagedScope {
+    paths: HashSet<PathBuf>,
+}
+
+impl ManagedScope {
+    fn parse(value: &str) -> Result<Self, String> {
+        let entries: Vec<String> = serde_json::from_str(value)
+            .map_err(|_| "Invalid KAUS_CODEX_SKILL_ALLOWLIST".to_owned())?;
+        let mut paths = HashSet::new();
+        for entry in entries {
+            let path = PathBuf::from(entry);
+            if !path.is_absolute() || path.file_name().is_none_or(|name| name != "SKILL.md") {
+                return Err("Project skill scope requires absolute SKILL.md paths".to_owned());
+            }
+            let canonical = path
+                .canonicalize()
+                .map_err(|_| "Project skill scope file is unavailable".to_owned())?;
+            if canonical != path || !canonical.is_file() {
+                return Err("Project skill scope must use canonical files".to_owned());
+            }
+            paths.insert(canonical);
+        }
+        Ok(Self { paths })
+    }
+
+    fn allows(&self, path: &Path) -> bool {
+        self.paths.contains(path) && path.canonicalize().is_ok_and(|canonical| canonical == path)
+    }
+
+    fn allows_entry(&self, entry: &SkillCatalogEntry) -> bool {
+        entry.authority.kind == SkillSourceKind::Host
+            && self.allows(Path::new(entry.main_prompt.as_str()))
+    }
+
+    fn filter(&self, mut outcome: SkillLoadOutcome) -> SkillLoadOutcome {
+        outcome
+            .skills
+            .retain(|skill| self.allows(skill.path_to_skills_md.as_path()));
+        outcome
+            .errors
+            .retain(|error| self.allows(error.path.as_path()));
+        let disabled = outcome.disabled_paths.clone();
+        outcome.with_disabled_paths(disabled)
+    }
+}
+
+fn scope() -> Result<Option<&'static ManagedScope>, &'static str> {
+    match SCOPE.get_or_init(|| match std::env::var("KAUS_CODEX_SKILL_ALLOWLIST") {
+        Ok(value) => ManagedScope::parse(&value).map(Some),
+        Err(std::env::VarError::NotPresent) => Ok(None),
+        Err(_) => Err("Invalid KAUS_CODEX_SKILL_ALLOWLIST encoding".to_owned()),
+    }) {
+        Ok(value) => Ok(value.as_ref()),
+        Err(error) => Err(error.as_str()),
+    }
+}
+
+/// Freeze and validate the process scope before starting any transport or session.
+pub fn initialize_managed_skill_scope() -> Result<(), String> {
+    scope().map(|_| ()).map_err(str::to_owned)
+}
+
+pub(crate) fn filter_outcome(
+    outcome: std::sync::Arc<SkillLoadOutcome>,
+) -> std::sync::Arc<SkillLoadOutcome> {
+    match scope() {
+        Ok(None) => outcome,
+        Ok(Some(scope)) => std::sync::Arc::new(scope.filter((*outcome).clone())),
+        Err(error) => panic!("{error}"),
+    }
+}
+
+pub(crate) fn host_roots() -> Option<Vec<crate::loader::HostSkillRoot>> {
+    match scope() {
+        Ok(None) => None,
+        Ok(Some(scope)) => {
+            let mut paths = scope.paths.iter().collect::<Vec<_>>();
+            paths.sort();
+            Some(
+                paths
+                    .into_iter()
+                    .filter_map(|path| {
+                        let parent = path.parent()?;
+                        let root =
+                            codex_utils_absolute_path::AbsolutePathBuf::try_from(parent).ok()?;
+                        Some(crate::loader::HostSkillRoot::host(
+                            root,
+                            codex_protocol::protocol::SkillScope::User,
+                            std::sync::Arc::clone(&codex_exec_server::LOCAL_FS),
+                        ))
+                    })
+                    .collect(),
+            )
+        }
+        Err(_) => Some(Vec::new()),
+    }
+}
+
+pub(crate) fn allows_path(path: &Path) -> bool {
+    match scope() {
+        Ok(None) => true,
+        Ok(Some(scope)) => scope.allows(path),
+        Err(_) => false,
+    }
+}
+
+pub(crate) fn allows_source(kind: &SkillSourceKind) -> bool {
+    match scope() {
+        Ok(None) => true,
+        Ok(Some(_)) => *kind == SkillSourceKind::Host,
+        Err(_) => false,
+    }
+}
+
+pub(crate) fn allows_entry(entry: &SkillCatalogEntry) -> bool {
+    match scope() {
+        Ok(None) => true,
+        Ok(Some(scope)) => scope.allows_entry(entry),
+        Err(_) => false,
+    }
+}
