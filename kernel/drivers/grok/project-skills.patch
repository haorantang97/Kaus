+// Kaus modification: runtime discoveries and plugin reloads obey the same
+// exact-file selection as initial discovery. The native process has no scope env.
+fn kaus_scope_skills(skills: Vec<SkillInfo>) -> Vec<SkillInfo> {
+    let Some(raw) = std::env::var_os("KAUS_GROK_SKILL_ALLOWLIST") else { return skills; };
+    let paths = raw.to_str().and_then(|value| serde_json::from_str::<Vec<String>>(value).ok()).unwrap_or_default();
+    let allowed: HashSet<PathBuf> = paths.iter().filter_map(|path| dunce::canonicalize(path).ok()).collect();
+    skills.into_iter().filter(|skill| dunce::canonicalize(&skill.path)
+        .is_ok_and(|path| allowed.contains(&path))).collect()
+}
