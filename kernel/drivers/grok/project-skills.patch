+fn kaus_filter_selected(skills: Vec<SkillInfo>, selection: Option<&std::ffi::OsStr>) -> Vec<SkillInfo> {
+    let Some(selection) = selection else { return skills; };
+    let paths = selection.to_str().and_then(|raw| serde_json::from_str::<Vec<String>>(raw).ok());
+    let Some(paths) = paths else {
+        tracing::warn!("Invalid Kaus skill selection; no skills loaded");
+        return Vec::new();
+    };
+    let allowed: HashSet<PathBuf> = paths.iter()
+        .filter_map(|path| dunce::canonicalize(path).ok())
+        .collect();
+    // Explicit copies are loaded directly, so native same-name precedence and
+    // a config layer that omits skills.paths cannot hide the selected skill.
+    collect_config_skills(&paths, None).into_iter().filter(|skill| dunce::canonicalize(&skill.path)
+        .is_ok_and(|path| allowed.contains(&path))).collect()
 }
 
